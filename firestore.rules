rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    // Music Collection: Anyone can read active tracks, registered artists and admins can manage
    match /music/{musicId} {
      allow read: if isValidId(musicId);
      allow create, update, delete: if isValidId(musicId);
    }

    // Artists Collection: Public profiles are readable, registration/login writes are permitted
    match /artists/{artistId} {
      allow read: if isValidId(artistId);
      allow create, update: if isValidId(artistId);
      allow delete: if isValidId(artistId);
    }

    // Donations Collection: Fans can submit proof of transfer; Admin validates
    match /donations/{donationId} {
      allow read, create, update, delete: if isValidId(donationId);
    }

    // Social Posts Collection: Publicly readable; artist posts
    match /social_posts/{postId} {
      allow read, create, update, delete: if isValidId(postId);
    }

    // Social Comments Collection
    match /social_comments/{commentId} {
      allow read, create, update, delete: if isValidId(commentId);
    }

    // Artist Inbox
    match /artist_inbox/{msgId} {
      allow read, create, update, delete: if isValidId(msgId);
    }

    // Pubs & RPA
    match /pubs/{pubId} {
      allow read, write: if isValidId(pubId);
    }
    match /rpa/{rpaId} {
      allow read, write: if isValidId(rpaId);
    }

    // Archives & Settings
    match /archives/{archiveId} {
      allow read, write: if isValidId(archiveId);
    }
    match /system_settings/{settingId} {
      allow read, write: if isValidId(settingId);
    }

    // Connection Test
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
